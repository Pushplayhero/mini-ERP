# Copy to .env and adjust as needed. app/core/settings.py reads these via
# pydantic-settings; docker-compose.yml reads the POSTGRES_* / APP_* ones
# directly for the postgres service and to build the app's DATABASE_URL.

# --- Postgres (used by docker-compose's `postgres` service) ---
POSTGRES_USER=mini_erp
POSTGRES_PASSWORD=mini_erp
POSTGRES_DB=mini_erp
POSTGRES_PORT=5432

# --- App ---
APP_PORT=8000
APP_ENVIRONMENT=development

# Full async SQLAlchemy DSN the app + alembic connect with. When running via
# `docker compose up`, docker-compose.yml builds this for you from the
# POSTGRES_* vars above (pointing at the `postgres` service by hostname).
# When running the app directly on your host (not in docker), set this to
# point at localhost instead, e.g.:
# DATABASE_URL=postgresql+asyncpg://mini_erp:mini_erp@localhost:5432/mini_erp
DATABASE_URL=postgresql+asyncpg://mini_erp:mini_erp@localhost:5432/mini_erp

# --- Initial Admin Bootstrap (Mandatory for make bootstrap / make demo) ---
# Secrets MUST NOT be committed here. Set these values when bootstrapping.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Staging & Production Security Hardening (ADR-018) ---
# Comma-separated or JSON array of MultiFernet keys (primary key first; older keys follow for rotation).
# Mandatory when APP_ENVIRONMENT is staging/production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MINI_ERP_SECRET_ENCRYPTION_KEYS=
# Enforce PostgreSQL Row-Level Security (SET LOCAL ROLE mini_erp_app + app.current_company_id).
# In staging/production, prefer separate DB credentials: run migrations as table owner, and run
# the API/workers under a dedicated LOGIN NOSUPERUSER NOBYPASSRLS role granted `mini_erp_app`.
MINI_ERP_DATABASE_ENFORCE_RLS=true
# Bearer session lifecycle bounds
MINI_ERP_SESSION_TTL_HOURS=12
MINI_ERP_SESSION_IDLE_TIMEOUT_MINUTES=60
MINI_ERP_SESSION_TOUCH_INTERVAL_SECONDS=60
MINI_ERP_SESSION_MAX_ACTIVE_PER_USER=10
# Fail-closed CORS (empty list disables CORS headers completely).
# In staging/production, wildcard '*', 'null', and insecure 'http://' origins are rejected at startup.
MINI_ERP_CORS_ALLOWED_ORIGINS=[]
MINI_ERP_CORS_ALLOW_CREDENTIALS=false
MINI_ERP_CORS_MAX_AGE_SECONDS=600

# --- Plugin Configuration (ADR-010 / WEEK10) ---
# Set to false to disable scanning external Python entry points (mini_erp.plugins).
# MINI_ERP_ENABLE_PLUGIN_ENTRYPOINTS=true
# Optional comma/JSON list of plugin names to exclude from loading at startup.
# MINI_ERP_DISABLED_PLUGINS=[]
