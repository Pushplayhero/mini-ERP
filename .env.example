# Copy to .env and adjust as needed. app/core/settings.py reads these via
# pydantic-settings; docker-compose.yml reads the POSTGRES_* / APP_* ones
# directly for the postgres service and to build the app's DATABASE_URL.

# --- Postgres (used by docker-compose's `postgres` service) ---
POSTGRES_USER=mini_erp
POSTGRES_PASSWORD=mini_erp
POSTGRES_DB=mini_erp
POSTGRES_PORT=5432

# --- App ---
APP_PORT=8000
APP_ENVIRONMENT=development

# Full async SQLAlchemy DSN the app + alembic connect with. When running via
# `docker compose up`, docker-compose.yml builds this for you from the
# POSTGRES_* vars above (pointing at the `postgres` service by hostname).
# When running the app directly on your host (not in docker), set this to
# point at localhost instead, e.g.:
# DATABASE_URL=postgresql+asyncpg://mini_erp:mini_erp@localhost:5432/mini_erp
DATABASE_URL=postgresql+asyncpg://mini_erp:mini_erp@localhost:5432/mini_erp
